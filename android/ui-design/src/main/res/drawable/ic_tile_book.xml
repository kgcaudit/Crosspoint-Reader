<!-- An open book: two facing pages from a centre spine, the tile colour showing
     through as the spine. For the EBOOK kind (epub). Clean pages, no panel
     lines, so it is told from ic_tile_comic (same open-book idea, but panel
     lines and the archive hue) by the gutter shading and the document hue it
     sits on. White on its tile, like the other tiles; the gutter detail is the
     two-tone #8CFFFFFF. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Left page. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.4 7.4C8.9 6.0 5.4 5.9 3.5 6.8C3.3 6.88 3.2 7.08 3.2 7.3L3.2 17.0C3.2 17.3 3.5 17.52 3.8 17.42C5.8 16.7 9.0 16.8 11.4 18.0Z" />
    <!-- Right page. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.6 7.4C15.1 6.0 18.6 5.9 20.5 6.8C20.7 6.88 20.8 7.08 20.8 7.3L20.8 17.0C20.8 17.3 20.5 17.52 20.2 17.42C18.2 16.7 15.0 16.8 12.6 18.0Z" />
    <!-- The gutter: a slim valley between the pages, at reduced alpha so the
         book reads as open rather than as two separate cards. -->
    <path
        android:fillColor="#8CFFFFFF"
        android:pathData="M11.6 8.0C11.85 8.13 12.0 8.4 12.0 8.7L12.0 17.9C12.0 17.6 11.85 17.33 11.6 17.2ZM12.4 8.0C12.15 8.13 12.0 8.4 12.0 8.7L12.0 17.9C12.0 17.6 12.15 17.33 12.4 17.2Z" />
