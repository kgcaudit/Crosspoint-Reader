<?xml version="1.0" encoding="utf-8"?>
<!--
    "이어 읽기(한 권)" 의 고르기 화면 미리보기(0.56.1). 작은 판(widget_continue_small)과 같은 뼈대에 본보기 글을 박았다 — 작은 판을
    고치면 여기도 고친다(시험이 두 판의 id 를 맞대 본다).

    원래 설명: "이어 읽기" 위젯 · 작은 판(2×2, 0.56.0 사용자 확정 구상안). 한 권만: 표지(원래 비율)를 가운데, 아래에 제목 한 줄 · 막대 · %.
    작은 칸에 목록까지 넣으면 어느 것도 읽히지 않는다(조사: 다른 읽기 앱의 2×2 도 한 권).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 판은 그림으로 깐다 — 불투명도(setImageAlpha) · 밝게/어둡게(setColorFilter)를 RemoteViews 로 바꿀 수 있는 것이 ImageView 뿐이다.
         배경을 끄면 이 그림만 숨긴다. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 표지는 원래 비율로(0.56.0). 0.55 까지는 84dp 칸에 꽉 채워 위아래 · 옆이 잘렸다(사용자 지적). 높이를 칸에 맞추고 폭은 그림이
             정한다(adjustViewBounds). 표지 없는 책은 투명한 2:3 그림으로 칸만 잡고 그 위에 제목 카드를 얹는다. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:maxWidth="120dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_sample_cover" />

            <TextView
                android:id="@+id/widget_cover_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_cover_blank"
                android:ellipsize="end"
                android:gravity="top|start"
                android:maxLines="4"
                android:padding="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="데미안" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_title"
            android:text="@string/widget_sample_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="데미안" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/widget_progress"
                android:progress="640"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="1000"
                android:progressDrawable="@drawable/widget_progress" />

            <TextView
                android:id="@+id/widget_percent"
                android:text="@string/widget_sample_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp"
                tools:text="61%" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
