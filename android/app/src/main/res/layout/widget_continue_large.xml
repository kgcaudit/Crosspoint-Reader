<?xml version="1.0" encoding="utf-8"?>
<!--
    "이어 읽기" 위젯 · 큰 판(4×4, 0.56.0 사용자 확정 구상안). 위에 지금 읽는 것을 크게, 아래에 최근에 읽은 것 세 줄(작은 표지 ·
    제목 · 저자 · 막대). 줄마다 누르면 그 책이 열린다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 판은 그림으로 깐다 — 불투명도(setImageAlpha) · 밝게/어둡게(setColorFilter)를 RemoteViews 로 바꿀 수 있는 것이 ImageView 뿐이다.
         배경을 끄면 이 그림만 숨긴다. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:minHeight="120dp"
            android:orientation="horizontal">

            <!-- 표지는 원래 비율로(0.56.0). 0.55 까지는 84dp 칸에 꽉 채워 위아래 · 옆이 잘렸다(사용자 지적). 높이를 칸에 맞추고 폭은 그림이
                 정한다(adjustViewBounds). 표지 없는 책은 투명한 2:3 그림으로 칸만 잡고 그 위에 제목 카드를 얹는다. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
    
                <ImageView
                    android:id="@+id/widget_cover"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:maxWidth="140dp"
                    android:scaleType="fitCenter" />
    
                <TextView
                    android:id="@+id/widget_cover_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_cover_blank"
                    android:ellipsize="end"
                    android:gravity="top|start"
                    android:maxLines="5"
                    android:padding="8dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="데미안" />
            </FrameLayout>
    
            <!-- 위 판의 높이 나눔(세로)과 글 칸의 폭 나눔(가로)은 축이 달라 두 번 재지 않는다. -->
            <FrameLayout
                android:id="@+id/widget_main"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                tools:ignore="NestedWeights">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="vertical">
    
                    <TextView
                        android:id="@+id/widget_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_continue_label"
                        android:textColor="@color/widget_accent_text"
                        android:textSize="12sp" />
    
                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/widget_text"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="데미안" />
    
                    <TextView
                        android:id="@+id/widget_byline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="13sp"
                        tools:text="헤르만 헤세" />
                </LinearLayout>
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical">
    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">
    
                        <TextView
                            android:id="@+id/widget_percent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/widget_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="61%" />
    
                        <TextView
                            android:id="@+id/widget_remaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/widget_text_muted"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:text="남은 1시간 20분" />
                    </LinearLayout>
    
                    <ProgressBar
                        android:id="@+id/widget_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="5dp"
                        android:indeterminate="false"
                        android:max="1000"
                        android:progressDrawable="@drawable/widget_progress" />
                </LinearLayout>
    
            </FrameLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@color/widget_track" />

        <LinearLayout
            android:id="@+id/widget_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_recent_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_recent_label"
                android:textColor="@color/widget_text_muted"
                android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/widget_recent_1"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/widget_recent_cover_1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:maxWidth="40dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/widget_recent_blank_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_cover_blank"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_recent_title_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/widget_recent_percent_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_recent_byline_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/widget_recent_progress_1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progressDrawable="@drawable/widget_progress_thin" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_recent_2"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/widget_recent_cover_2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:maxWidth="40dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/widget_recent_blank_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_cover_blank"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_recent_title_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/widget_recent_percent_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_recent_byline_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/widget_recent_progress_2"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progressDrawable="@drawable/widget_progress_thin" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_recent_3"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/widget_recent_cover_3"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:maxWidth="40dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/widget_recent_blank_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_cover_blank"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_recent_title_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/widget_recent_percent_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_recent_byline_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/widget_recent_progress_3"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progressDrawable="@drawable/widget_progress_thin" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
