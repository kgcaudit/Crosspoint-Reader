<?xml version="1.0" encoding="utf-8"?>
<!--
    "이어 읽기" 위젯의 크기 · 갱신. 처음엔 4×2 칸, 2×2 까지 줄이고 4×4 이상으로 늘일 수 있다 — 크기마다 배치가 바뀐다(0.56.0).
    updatePeriodMillis 는 0 — 정해 둔 때마다 깨어나지 않는다. 읽은 자리가 바뀔 때 앱이 직접 고쳐 그린다(배터리를 쓰지 않게).
    휴대폰을 켤 때는 시스템이 한 번 그리라고 부른다.

    미리보기(0.56.0): 0.55 까지는 빈 판(앱 아이콘)을 미리보기로 써서 위젯 고르기 화면에 아이콘만 달랑 보였다(사용자 지적).
    안드로이드 12+ 는 previewLayout(실제 모양), 그 아래는 previewImage(같은 모양을 찍은 그림).

    설정(0.56.0): 놓을 때 설정 화면을 열되 건너뛸 수 있고(configuration_optional — 안드로이드 12+), 길게 눌러 다시 열 수 있다
    (reconfigurable). 그 아래 판에서는 놓을 때 설정 화면이 반드시 뜬다.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="io.github.kgcaudit.reader.app.WidgetSettingsActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_continue_empty"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="90dp"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_continue_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional"
    tools:targetApi="s" />
