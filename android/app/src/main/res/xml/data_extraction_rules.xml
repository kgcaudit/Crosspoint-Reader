<?xml version="1.0" encoding="utf-8"?>
<!-- 안드로이드 12 이상의 백업·기기 이전. backup_rules.xml 과 같은 이유로 캐시와 사용자 글꼴을 뺀다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pages/" />
        <exclude domain="file" path="fonts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pages/" />
    </device-transfer>
</data-extraction-rules>
