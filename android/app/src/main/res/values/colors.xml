<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 앱 아이콘은 OLO-Design 의 appicons/launcher.py 가 eBook 용으로 만든 drawable/ic_launcher_*.xml 이다(0.31.0).
         색은 그 파일 안에 있다 — 여기서 고치지 않고 디자인 저장소에서 고쳐 다시 가져온다. -->
    <!-- 앱이 뜨기 전 창 배경. CpTheme 의 background 와 같아야 첫 화면이 번쩍이지 않는다. -->
    <color name="window_background">#FFF7F4EF</color>

    <!-- 홈 화면 "이어 읽기" 위젯(사용자 결정 3-1). 위젯은 컴포즈가 아니라 RemoteViews 라 CpTheme 을 읽지 못한다 — 같은 값을
         여기 옮겨 적는다(CpTheme 의 LightColors / DarkColors). 테마 값을 바꾸면 여기도 바꾼다(ContinueWidgetTest 가 붙든다). -->
    <color name="widget_surface">#FFFCFAF6</color>
    <color name="widget_text">#FF1D1A16</color>
    <color name="widget_text_muted">#FF574D45</color>
    <color name="widget_accent">#FFB95B3B</color>
    <color name="widget_accent_text">#FF9A4A2C</color>
    <color name="widget_track">#FFDCD3C6</color>
    <!-- 표지가 없는 책의 대신 표지(보관 타일 황토). 흰 제목을 얹는다. -->
    <color name="widget_cover_blank">#FF8A6A3B</color>
</resources>
