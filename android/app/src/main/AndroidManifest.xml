<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 사용자에게 묻는 권한이 없다. 책은 사용자가 SAF 로 고른 폴더에서만 읽는다(저장소 전체 권한 불필요).
         인터넷은 '동기화 설정' 을 켰을 때만 쓴다(아래). 화면 끄고 듣기에 필요한 권한 셋(설치할 때 저절로 허락됨)은
         :reader-reflow 의 매니페스트에 있다. -->

    <!-- 읽기 잠금의 "알림도 끄기"(방해 금지). 묻는 권한이 아니다(설치할 때 허락) — 이것을 밝혀야 설정 › 방해 금지 권한 목록에
         앱이 오르고, 사람이 거기서 켜 준다. 전화 감지는 권한 없이 한다(오디오 모드 · 31 앞의 전화 상태). READ_PHONE_STATE 는
         묻지 않는다. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- 동기화 설정(0.58.0): 켰을 때만 사람이 정한 FTP · FTPS · SFTP 서버에 읽은 자리를 올리고 받는다. 끄면 통신하지 않는다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 사전(N4): 고른 말을 휴대폰에 깔린 사전 · 번역 앱에 넘긴다(ACTION_PROCESS_TEXT). 안드로이드 11 부터는
         무엇을 찾는지 밝히지 않으면 그런 앱이 깔려 있어도 "없음" 으로 보인다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".OloApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Olo">

        <!-- configChanges: 회전·다크 모드 전환에 액티비티를 다시 만들지 않는다. 다시 만들면
             열려 있던 책(EPUB 파일 디스크립터)을 닫고 다시 열어야 한다. Compose 가 새 크기로
             다시 그리고, 조판은 새 크기의 캐시로 읽던 글자에 돌아온다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 파일 관리자의 "연결 프로그램" 목록에 오르려면 여는 형식을 밝혀야 한다. 안드로이드는
                 이 선언을 보고 목록을 만든다(앱이 할 수 있는 일을 스스로 알리지 않으면 없는 앱이다).
                 content 만 받는다: file:// 은 안드로이드 7 부터 앱 사이에 넘길 수 없다.
                 만화 압축은 이름 있는 형식(cbz · cbr …)과 그냥 압축(zip · rar · 7z · tar)을 모두 밝힌다 — 만화를 받은 그대로
                 .zip 으로 두는 사람이 많다. 그냥 zip 은 열 때 살펴 그림이 없으면 까닭을 알린다(Incoming).
                 octet-stream("모르는 형식")도 받는다: 여러 파일 관리자가 epub · cbz 에 이것을 붙여 보내, 빼면 그 책이 목록에 없다.
                 이름으로 가려 못 여는 것은 까닭을 알린다. 아무 형식(*/*)은 밝히지 않는다 — 사진 · 음악을 열 때마다 목록에 끼면 성가실
                 뿐 열지도 못한다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/x-cbr" />
                <data android:mimeType="application/x-cb7" />
                <data android:mimeType="application/x-cbt" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- 홈 화면 "이어 읽기" 위젯(사용자 결정 3-1). 그리라는 부름은 시스템(위젯 서비스)만 보낸다 — 밖에 열지 않는다. -->
        <receiver
            android:name=".ContinueWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/continue_widget_info" />
        </receiver>

        <!-- 같은 위젯의 2×2 항목(0.56.1). 고르기 화면에 크기마다 한 항목씩 보이려면 받는 쪽이 따로 있어야 한다. -->
        <receiver
            android:name=".ContinueWidgetSingle"
            android:exported="false"
            android:label="@string/widget_name_single">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/continue_widget_single_info" />
        </receiver>

        <!-- 위젯 설정(0.56.0): 위젯을 놓을 때 · 길게 눌러 "설정" 을 고를 때 런처가 연다. 런처는 다른 앱이라 밖에 열어 둔다 —
             받은 위젯 번호의 모양 설정만 바꿀 수 있어, 다른 앱이 열어도 할 수 있는 일이 없다. -->
        <activity
            android:name=".WidgetSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
